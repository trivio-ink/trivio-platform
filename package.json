{
  "name": "trivio-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Payment Settlement Intelligence Platform",
  "homepage": "https://trivio.ink",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trivio-ink/trivio-platform.git"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "build:packages": "npm run --workspace=@trivio.ink/core build && npm run --workspace=@trivio.ink/node build && npm run --workspace=@trivio.ink/react build",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "test": "vitest run",
    "test:unit": "vitest run --exclude tests/api-db.integration.test.ts",
    "test:db": "vitest run tests/api-db.integration.test.ts",
    "check": "npm run build && npm run typecheck && npm test",
    "validate:pr": "node scripts/validate-pr-description.mjs",
    "verify:release": "node scripts/verify-consumer-acceptance.mjs",
    "test:tarball": "node scripts/test-isolated-tarballs.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "^5.7.3",
    "vitest": "^5.1.0"
  }
}
